{
  "source": "Phase 0-3 performance transport and projection-backed view commands",
  "types": [
    {
      "name": "CursorPage<T>",
      "fields": [
        "items: T[];",
        "nextCursor?: string;",
        "totalApprox?: number;"
      ]
    },
    {
      "name": "SummaryViewRow",
      "fields": [
        "pageId: string;",
        "kind: string;",
        "path: string;",
        "title: string;",
        "bodyExcerpt?: string | null;",
        "bodyHash?: string | null;",
        "bodyLength?: number | null;",
        "props: Record<string, unknown>;",
        "createdAt: string;",
        "updatedAt: string;"
      ]
    },
    {
      "name": "PageMutateRequest",
      "fields": [
        "pageId: string;",
        "props: Record<string, unknown>;",
        "title?: string;",
        "body?: string | null;"
      ]
    },
    {
      "name": "ViewProjectionRebuildResult",
      "fields": [
        "pagesScanned: number;",
        "taskRows: number;",
        "projectRows: number;",
        "noteRows: number;",
        "calendarRows: number;"
      ]
    }
  ],
  "commands": [
    {
      "name": "tasks_list_view",
      "signature": "(cursor?: string, limit = 500): Promise<CursorPage<SummaryViewRow>>",
      "retry": true,
      "requestExpression": "{ ...(cursor ? { cursor } : {}), limit }"
    },
    {
      "name": "projects_list_view",
      "signature": "(cursor?: string, limit = 500): Promise<CursorPage<SummaryViewRow>>",
      "retry": true,
      "requestExpression": "{ ...(cursor ? { cursor } : {}), limit }"
    },
    {
      "name": "notes_tree_view",
      "signature": "(kind?: string, cursor?: string, limit = 500): Promise<CursorPage<SummaryViewRow>>",
      "retry": true,
      "requestExpression": "{ ...(kind ? { kind } : {}), ...(cursor ? { cursor } : {}), limit }"
    },
    {
      "name": "page_mutate",
      "signature": "(request: PageMutateRequest): Promise<Page>",
      "retry": false,
      "requestExpression": "{ request }"
    },
    {
      "name": "page_detail",
      "signature": "(pageId: string): Promise<Page>",
      "retry": false,
      "requestExpression": "{ pageId }"
    },
    {
      "name": "calendar_occurrences",
      "signature": "(startDate: Date, endDate: Date, cursor?: string, limit = 500): Promise<CursorPage<Page>>",
      "retry": true,
      "requestExpression": "{ startDate: startDate.toISOString(), endDate: endDate.toISOString(), ...(cursor ? { cursor } : {}), limit }"
    },
    {
      "name": "search_query",
      "signature": "(query: string, cursor?: string, limit = 50): Promise<CursorPage<Page>>",
      "retry": true,
      "requestExpression": "{ query, ...(cursor ? { cursor } : {}), limit }"
    },
    {
      "name": "view_projection_rebuild",
      "signature": "(): Promise<ViewProjectionRebuildResult>",
      "retry": false,
      "requestExpression": "undefined"
